package main

import "fmt"

type Handler struct{ name string }

func mk() *Handler { return &Handler{name: "h"} }

// OK — every element / map value is a non-nil construction-site expression.
func ok() {
	s := []!*Handler{mk(), mk()}
	m := map[string]!*Handler{"a": mk()}
	a := [2]!*Handler{mk(), mk()}
	g := [...]!*Handler{mk()} // inferred length: no zero-fill
	var both ![]!*Handler = []!*Handler{mk()}
	fmt.Println(s, m, a, g, both)
}

// GN001 — explicit nil written as an element / map value.
func nilElem() {
	_ = []!*Handler{nil}
	_ = map[string]!*Handler{"k": nil}
}

// GN002 — fixed-array literal leaves a !*Handler index at its zero value.
var slots = [3]!*Handler{2: mk()}

// GN003 — element ! on a channel element, a map key, or a non-nilable kind.
var (
	_ chan !*Handler
	_ map[!*Handler]int
	_ []!int
)

func main() { ok(); nilElem() }
