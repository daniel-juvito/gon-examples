// return-value — v1.1: annotated !T result is a non-nil source at immediate use.
package main

// MustName always returns a non-nil string pointer (local contract).
func MustName() !*string {
	s := "gon"
	return &s
}

// Open: only result[0] is non-nil (local multi-return contract).
func Open() (!*string, error) {
	s := "cfg"
	return &s, nil
}

func main() {
	// Short declaration: MustName result promotes name to non-nil source.
	name := MustName()
	if name == nil { // GW001 — always false
	}

	// var without explicit type: same promotion.
	var n = MustName()
	_ = n

	// Multi-return: only the annotated position is a non-nil source.
	f, err := Open()
	_ = err
	if f == nil { // GW001
	}

	// Explicit type on the binding is non-nil from the type itself.
	var explicit !*string = MustName()
	_ = explicit

	// Conversion does not propagate source-ness (v1.1 boundary).
	converted := (*string)(name)
	_ = converted
}
