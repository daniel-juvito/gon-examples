// flow-ok — Gon is not flow-sensitive: a non-literal assignment is not an error.
// Since v1.21 an ordinary *string into a !*string slot is a warning (GW006, exit 0).
package main

func get() *string {
	return nil // runtime nil is fine; Gon does not track it
}

func main() {
	var x !*string = get() // not an error; GW006 warns since v1.21 (use (!*string)(get()) to claim non-nil)
	_ = x
}
