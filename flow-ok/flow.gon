// flow-ok — Gon is not flow-sensitive, so it never takes an ordinary value to be
// non-nil: since v1.22 it is GN001, and the author makes the claim with (!T)(x).
// (Until v1.20 this was accepted silently, and in v1.21 it was the warning GW006.)
package main

func get() *string {
	return nil // runtime nil is possible; Gon does not track it
}

func main() {
	var x !*string = get()            // GN001 — an ordinary *string into a !*string slot
	var y !*string = (!*string)(get()) // ok — the explicit claim; no run-time check
	_, _ = x, y
}
